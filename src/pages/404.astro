---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Not found">
  <section class="entry-page">
    <header class="entry-page__header">
      <p class="section-kicker">404</p>
      <h1 class="entry-page__title">This page does not exist.</h1>
      <p class="entry-page__summary">The link may be wrong, or the entry may have been renamed.</p>
      <a class="entry-page__backlink" href="/">← Return home</a>
    </header>
  </section>
</BaseLayout>
