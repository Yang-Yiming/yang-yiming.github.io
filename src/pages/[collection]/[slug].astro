---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { capitalize, entryCollections, formatMonth, getEntries, type Entry } from "../../lib/content";

export async function getStaticPaths() {
  const entries = (await Promise.all(entryCollections.map(getEntries))).flat();
  return entries
    .filter((entry) => !entry.data.external)
    .map((entry) => ({ params: { collection: entry.collection, slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, label, embed } = entry.data;
---
<BaseLayout title={title} description={summary} activeSection={entry.collection}>
  <article class="entry-page">
    <header class="entry-page__header">
      <a class="entry-page__backlink" href={`/#${entry.collection}`}>← Back to {capitalize(entry.collection)}</a>
      <p class="section-kicker">{capitalize(entry.collection)}{label && ` · ${label}`}</p>
      <h1 class="entry-page__title">{title}</h1>
      <time class="entry-page__meta" datetime={date.toISOString()}>{formatMonth(date)}</time>
      <p class="entry-page__summary">{summary}</p>
    </header>
    <div class="prose"><Content /></div>
    {embed && <iframe class="entry-page__frame" src={embed} title={title} loading="lazy" />}
  </article>
</BaseLayout>
