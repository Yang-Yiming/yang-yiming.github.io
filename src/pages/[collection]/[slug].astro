---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getAllEntries, getEntry } from "../../content/entries";
import type { EntryCollectionId } from "../../types";

export async function getStaticPaths() {
  const entries = await getAllEntries();
  return entries.map((entry) => ({
    params: { collection: entry.collectionId, slug: entry.slug },
  }));
}

const collection = Astro.params.collection as EntryCollectionId;
const slug = Astro.params.slug ?? "";
const entry = await getEntry(collection, slug);

if (!entry) {
  throw new Error(`Entry not found: ${collection}/${slug}`);
}

const { Content } = await render(entry.sourceEntry as Parameters<typeof render>[0]);
const collectionLabel = collection.charAt(0).toUpperCase() + collection.slice(1);
---
<Layout title={`${entry.title} · Yang Yiming`} description={entry.summary}>
  <div class="page-shell">
    <SiteHeader activeSection={entry.collectionId} />
    <main class="page-main">
      <article class="entry-page">
        <div class="entry-page__header">
          <a class="entry-page__backlink" href={`/#${entry.collectionId}`}>← <span>Back to {collectionLabel}</span></a>
          <p class="section-kicker">{entry.kicker ?? entry.meta}</p>
          <h1 class="entry-page__title">{entry.title}</h1>
          <p class="entry-page__meta">{entry.meta}</p>
          <p class="entry-page__summary">{entry.summary}</p>
        </div>
        {entry.kind === "markdown" ? <div class="entry-page__content"><Content /></div> : null}
        {entry.open === "iframe" && entry.externalHref ? <iframe class="entry-page__frame" src={entry.externalHref} title={entry.title} /> : null}
        {(entry.open === "native" || entry.kind === "link") && entry.externalHref ? <p><a href={entry.externalHref}>Open {entry.title}</a></p> : null}
      </article>
    </main>
  </div>
</Layout>
