---
import "../styles.css";
import { siteMeta } from "../content/siteMeta";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteMeta.name, description = "Personal homepage for Yang Yiming." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      const savedTheme = localStorage.getItem("theme-mode");
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      const root = document.documentElement;
      const darkQuery = matchMedia("(prefers-color-scheme: dark)");
      const resolvedTheme = () => root.dataset.theme ?? (darkQuery.matches ? "dark" : "light");
      const themeButton = document.querySelector("[data-theme-toggle]");
      const syncThemeLabel = () => themeButton?.setAttribute("aria-label", `Switch to ${resolvedTheme() === "dark" ? "light" : "dark"} theme`);
      themeButton?.addEventListener("click", () => {
        const next = resolvedTheme() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme-mode", next);
        syncThemeLabel();
      });
      darkQuery.addEventListener("change", syncThemeLabel);
      syncThemeLabel();

      // Scroll-spy: highlight the nav link for the section crossing the upper third of the viewport.
      const nav = document.querySelector("[data-spy]");
      if (nav) {
        const links = [...nav.querySelectorAll("[data-section]")];
        const targets = links.map((link) => document.getElementById(link.dataset.section)).filter(Boolean);
        let ticking = false;
        const update = () => {
          ticking = false;
          const line = innerHeight * 0.33;
          const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
          let current = targets[0];
          for (const target of targets) {
            if (target.getBoundingClientRect().top <= line) current = target;
          }
          if (atBottom) current = targets[targets.length - 1];
          for (const link of links) {
            const active = link.dataset.section === current?.id;
            link.classList.toggle("is-active", active);
            if (active) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        };
        const schedule = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule, { passive: true });
        update();
      }
    </script>
  </body>
</html>
