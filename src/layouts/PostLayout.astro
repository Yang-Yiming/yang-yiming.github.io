---
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { NAV } from "../consts";
import { formatMonth, type Entry } from "../entries";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, label } = entry.data;
const section = NAV.find((item) => item.id === entry.collection)?.label;
---
<BaseLayout title={title} description={summary} activeSection={entry.collection}>
  <article class="entry-page">
    <header class="entry-page__header">
      <a class="entry-page__backlink" href={`/#${entry.collection}`}>← Back to {section}</a>
      <p class="section-kicker">{section}{label && ` · ${label}`}</p>
      <h1 class="entry-page__title">{title}</h1>
      <time class="entry-page__meta" datetime={date.toISOString()}>{formatMonth(date)}</time>
      <p class="entry-page__summary">{summary}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
