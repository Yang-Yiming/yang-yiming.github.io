---
import ListRow from "./ListRow.astro";
import { entryHref, entryLabel, getEntries, type EntryCollection } from "../entries";

interface Props {
  collection: EntryCollection;
  toggleable?: boolean;
}

const { collection, toggleable = false } = Astro.props;
const entries = await getEntries(collection);
---
{entries.length > 0 && (
  <div class="section-list">
    {entries.map((entry) => (
      <ListRow
        href={entryHref(entry)}
        label={entryLabel(entry)}
        title={entry.data.title}
        description={entry.data.summary}
        external={Boolean(entry.data.external)}
        featured={toggleable ? entry.data.featured : undefined}
      />
    ))}
  </div>
)}
