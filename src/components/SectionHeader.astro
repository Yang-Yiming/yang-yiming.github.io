---
import { NAV, sectionKicker, type SectionId } from "../consts";

interface Props {
  id: SectionId;
  title: string;
  source?: string;
}

const { id, title, source } = Astro.props;
const label = NAV.find((item) => item.id === id)?.label;
---
<div class="section-header">
  <div class="section-heading">
    <p class="section-kicker">{sectionKicker(id)}</p>
    <a class="section-heading-link" href={`#${id}`} aria-label={`Link to ${label} section`}>
      <span aria-hidden="true" class="section-heading-link__anchor">#</span>
      <h2 class="section-title">{title}</h2>
    </a>
  </div>
  <div class="section-body">
    {source && <p class="section-source-label">{source}</p>}
    <div class="section-intro prose-inline"><slot /></div>
  </div>
</div>
