---
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import { PROJECT_GROUPS, PROJECTS } from "../projects";

const groups = PROJECT_GROUPS.map((group) => ({
  ...group,
  items: PROJECTS.filter((project) => project.group === group.id),
})).filter((group) => group.items.length > 0);
---
<section class="editorial-section section-frame" id="projects">
  <SectionHeader id="projects" title="Projects." source="GitHub">
    <p>Selected GitHub work, grouped by how I participate: contributing to other repositories and maintaining my own.</p>
  </SectionHeader>
  <div class="projects-groups">
    {groups.map((group) => (
      <div class="projects-group">
        <p class="projects-group__title">{group.title}</p>
        <div class="projects-group__list">
          {group.items.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    ))}
  </div>
</section>
