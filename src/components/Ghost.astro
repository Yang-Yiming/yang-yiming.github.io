---
<div class="hero-ghost" aria-hidden="true" data-ghost>
  <canvas class="scene" data-ghost-canvas></canvas>
</div>

<script>
  import { Ghost } from "../scripts/ghost/ghost";
  import { createPoker } from "../scripts/ghost/poke";
  import { onGhostMode, readGhostMode, reducedMotion, ROAM_LANDED } from "../scripts/ghost/mode";

  const root = document.querySelector<HTMLElement>("[data-ghost]");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-ghost-canvas]");

  if (root && canvas) {
    const ghost = new Ghost(canvas);
    const poke = createPoker(ghost, JSON.parse(document.body.dataset.ghostPhotos ?? "[]"));
    let visible = true;
    let roaming = false;

    const sync = () => (visible && !roaming ? ghost.start() : ghost.stop());

    // While the roaming ghost is out, the hero one steps aside; it fades back in once the roamer has landed.
    const apply = (mode: string) => {
      ghost.setMode(mode === "roam" ? "calm" : (mode as "calm" | "lively"), { instant: true });
      roaming = mode === "roam" && !reducedMotion();
      if (roaming) root.dataset.roaming = "";
      sync();
    };
    apply(readGhostMode());
    onGhostMode(apply);
    document.addEventListener(ROAM_LANDED, () => {
      if (!roaming) delete root.dataset.roaming;
    });

    root.closest("[data-ghost-trigger]")?.addEventListener("click", poke);

    // Only simulate while visible.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(root);
  }
</script>
