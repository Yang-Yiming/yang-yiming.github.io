---
import type { ExperimentChartName } from "../data/meteorite";

const tabs: { id: ExperimentChartName; label: string }[] = [
  { id: "combined", label: "Combined" },
  { id: "new", label: "New" },
  { id: "old", label: "Old" },
];

const initial: ExperimentChartName = "combined";
---

<section class="experiment-chart" data-experiment-chart data-initial={initial}>
  <div class="experiment-chart__header">
    <p class="experiment-chart__sub">
      Hover, tap or tab to a point for details. Old is before the midterm, New is after.
    </p>
    <nav class="experiment-chart__tabs" aria-label="Chart selection">
      {
        tabs.map((tab) => (
          <button type="button" data-chart-tab={tab.id} class={tab.id === initial ? "is-active" : ""}>
            {tab.label}
          </button>
        ))
      }
    </nav>
  </div>

  <div class="experiment-chart__panel">
    <svg
      class="experiment-chart__svg"
      data-chart-svg
      role="group"
      aria-label="Test F1 for every submission in the meteorite-identification competition"
      viewBox="0 0 1100 600"
    ></svg>
    <div class="experiment-chart__tooltip" data-chart-tooltip aria-hidden="true"></div>
  </div>
</section>

<script>
  import { experimentCharts, type Experiment, type ExperimentChartName } from "../data/meteorite";

  const NS = "http://www.w3.org/2000/svg";

  function el(name: string, attrs: Record<string, string | number>, text?: string) {
    const node = document.createElementNS(NS, name);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
    if (text) node.textContent = text;
    return node;
  }

  const fmt = (value: number) => value.toFixed(5);

  const escapeHtml = (value: string) =>
    value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");

  document.querySelectorAll<HTMLElement>("[data-experiment-chart]").forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>("[data-chart-svg]");
    const tooltip = root.querySelector<HTMLElement>("[data-chart-tooltip]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-chart-tab]")];
    if (!svg || !tooltip) return;

    // .entry-page is a query container, which makes it the containing block for
    // fixed descendants. Re-parent the tooltip so it stays viewport-fixed.
    document.body.appendChild(tooltip);

    const TIP_PAD = 18;

    const moveTip = (clientX: number, clientY: number) => {
      const rect = tooltip.getBoundingClientRect();
      let x = clientX + 14;
      let y = clientY + 14;
      if (x + rect.width + TIP_PAD > window.innerWidth) x = clientX - rect.width - 14;
      if (y + rect.height + TIP_PAD > window.innerHeight) y = clientY - rect.height - 14;
      tooltip.style.left = `${Math.max(TIP_PAD, x)}px`;
      tooltip.style.top = `${Math.max(TIP_PAD, y)}px`;
    };

    const showTip = (clientX: number, clientY: number, point: Experiment) => {
      tooltip.innerHTML = `
        <div class="experiment-chart__tip-name">${escapeHtml(point.name)}</div>
        <div class="experiment-chart__tip-row"><span>Experiment</span><strong>#${point.x}</strong></div>
        <div class="experiment-chart__tip-row"><span>Test F1</span><strong>${fmt(point.score)}</strong></div>
        <div class="experiment-chart__tip-row"><span>Running best</span><strong>${fmt(point.best)}</strong></div>
        <div class="experiment-chart__tip-row"><span>Status</span><strong>${point.kept ? "new best" : "tried / not kept"}</strong></div>
      `;
      tooltip.classList.add("is-visible");
      moveTip(clientX, clientY);
    };

    const hideTip = () => tooltip.classList.remove("is-visible");

    // A tapped tooltip stays open until the next tap elsewhere or a scroll,
    // since a fixed tooltip would otherwise drift away from its point.
    document.addEventListener("pointerdown", (event) => {
      if (!(event.target as Element).closest?.(".experiment-chart__point")) hideTip();
    });
    window.addEventListener("scroll", hideTip, { passive: true });

    const render = (which: ExperimentChartName) => {
      tabs.forEach((tab) => tab.classList.toggle("is-active", tab.dataset.chartTab === which));
      while (svg.firstChild) svg.removeChild(svg.firstChild);

      const chart = experimentCharts[which];
      const data = chart.data;
      const width = 1100;
      const height = 600;
      const margin = { top: 52, right: 68, bottom: 68, left: 72 };
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

      const scores = data.map((point) => point.score);
      const xMax = data.length + 10;
      const yMin = Math.max(0.5, Math.min(...scores) - 0.025);
      const yMax = Math.min(0.85, Math.max(...scores) + 0.025);
      const innerW = width - margin.left - margin.right;
      const innerH = height - margin.top - margin.bottom;
      const sx = (x: number) => margin.left + (x / xMax) * innerW;
      const sy = (y: number) => margin.top + (1 - (y - yMin) / (yMax - yMin)) * innerH;

      svg.appendChild(
        el(
          "text",
          { x: width / 2, y: 30, class: "experiment-chart__chart-title", "text-anchor": "middle" },
          `${chart.title}: ${data.length} test evaluations, ${data.filter((point) => point.kept).length} new bests`,
        ),
      );

      const step = 0.05;
      for (let value = Math.ceil(yMin / step) * step; value <= yMax + 1e-9; value += step) {
        const tick = Number(value.toFixed(2));
        svg.appendChild(
          el("line", {
            x1: margin.left,
            x2: width - margin.right,
            y1: sy(tick),
            y2: sy(tick),
            stroke: "var(--line)",
            "stroke-width": 1,
          }),
        );
        svg.appendChild(
          el(
            "text",
            { x: margin.left - 12, y: sy(tick) + 4, class: "experiment-chart__tick", "text-anchor": "end" },
            tick.toFixed(2),
          ),
        );
      }

      const xStep = data.length > 80 ? 20 : data.length > 35 ? 10 : 5;
      for (let value = 0; value <= data.length; value += xStep) {
        svg.appendChild(
          el("line", {
            x1: sx(value),
            x2: sx(value),
            y1: margin.top,
            y2: height - margin.bottom,
            stroke: "var(--line)",
            "stroke-width": 1,
          }),
        );
        svg.appendChild(
          el(
            "text",
            {
              x: sx(value),
              y: height - margin.bottom + 24,
              class: "experiment-chart__tick",
              "text-anchor": "middle",
            },
            String(value),
          ),
        );
      }

      svg.appendChild(
        el("line", {
          x1: margin.left,
          x2: width - margin.right,
          y1: height - margin.bottom,
          y2: height - margin.bottom,
          stroke: "var(--text-soft)",
          "stroke-width": 1.2,
        }),
      );
      svg.appendChild(
        el("line", {
          x1: margin.left,
          x2: margin.left,
          y1: margin.top,
          y2: height - margin.bottom,
          stroke: "var(--text-soft)",
          "stroke-width": 1.2,
        }),
      );
      svg.appendChild(
        el(
          "text",
          { x: width / 2, y: height - 22, class: "experiment-chart__axis-label", "text-anchor": "middle" },
          "Experiment #",
        ),
      );
      svg.appendChild(
        el(
          "text",
          {
            x: 22,
            y: height / 2,
            class: "experiment-chart__axis-label",
            "text-anchor": "middle",
            transform: `rotate(-90 22 ${height / 2})`,
          },
          "Test F1 (higher is better)",
        ),
      );

      if (chart.splitAt) {
        const x = sx(chart.splitAt + 0.5);
        svg.appendChild(
          el("line", {
            x1: x,
            x2: x,
            y1: margin.top,
            y2: height - margin.bottom,
            stroke: "var(--text-muted)",
            "stroke-dasharray": "5 4",
            "stroke-width": 1.2,
          }),
        );
        svg.appendChild(
          el("text", { x: x + 8, y: margin.top + 24, class: "experiment-chart__tick" }, "new phase"),
        );
      }

      // Step line through the running best.
      let path = "";
      data.forEach((point, index) => {
        const x = sx(point.x);
        const y = sy(point.best);
        if (index === 0) path += `M ${x} ${y}`;
        else path += ` L ${x} ${sy(data[index - 1].best)} L ${x} ${y}`;
      });
      svg.appendChild(
        el("path", {
          d: path,
          fill: "none",
          stroke: "var(--ec-green)",
          "stroke-width": 2.8,
          opacity: 0.72,
        }),
      );

      data.forEach((point) => {
        const circle = el("circle", {
          cx: sx(point.x),
          cy: sy(point.score),
          r: point.kept ? 5.6 : 4.2,
          fill: point.kept ? "var(--ec-green)" : "var(--ec-gray)",
          stroke: point.kept ? "var(--ec-green-dark)" : "var(--ec-gray-stroke)",
          "stroke-width": point.kept ? 1.3 : 0.7,
          opacity: point.kept ? 0.98 : 0.72,
          class: "experiment-chart__point",
          tabindex: 0,
          role: "img",
          "aria-label": `#${point.x} ${point.name}: F1 ${fmt(point.score)}${point.kept ? ", new best" : ""}`,
        });
        circle.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "mouse") showTip(event.clientX, event.clientY, point);
        });
        circle.addEventListener("pointermove", (event) => {
          if (event.pointerType === "mouse") moveTip(event.clientX, event.clientY);
        });
        circle.addEventListener("pointerleave", (event) => {
          if (event.pointerType === "mouse") hideTip();
        });
        circle.addEventListener("pointerdown", (event) => {
          if (event.pointerType !== "mouse") showTip(event.clientX, event.clientY, point);
        });
        circle.addEventListener("focus", () => {
          const rect = circle.getBoundingClientRect();
          showTip(rect.left + rect.width / 2, rect.top + rect.height / 2, point);
        });
        circle.addEventListener("blur", hideTip);
        svg.appendChild(circle);
      });

      const legendX = width - 150;
      const legendY = height - 68;
      svg.appendChild(
        el("rect", {
          x: legendX - 12,
          y: legendY - 24,
          width: 150,
          height: 64,
          rx: 6,
          fill: "var(--bg-strong)",
          stroke: "var(--line)",
        }),
      );
      svg.appendChild(
        el("circle", {
          cx: legendX,
          cy: legendY - 4,
          r: 4.2,
          fill: "var(--ec-gray)",
          opacity: 0.72,
          stroke: "var(--ec-gray-stroke)",
        }),
      );
      svg.appendChild(
        el("text", { x: legendX + 14, y: legendY, class: "experiment-chart__legend" }, "Tried / not kept"),
      );
      svg.appendChild(
        el("circle", {
          cx: legendX,
          cy: legendY + 20,
          r: 5.6,
          fill: "var(--ec-green)",
          stroke: "var(--ec-green-dark)",
        }),
      );
      svg.appendChild(
        el("text", { x: legendX + 14, y: legendY + 24, class: "experiment-chart__legend" }, "New best"),
      );
    };

    tabs.forEach((tab) =>
      tab.addEventListener("click", () => render(tab.dataset.chartTab as ExperimentChartName)),
    );

    render((root.dataset.initial as ExperimentChartName) ?? "combined");
  });
</script>

<style is:global>
  .experiment-chart {
    --ec-green: light-dark(#2ecc71, #3ddc84);
    --ec-green-dark: light-dark(#176f3b, #1f9d55);
    --ec-gray: light-dark(#a9a9a9, #5c6675);
    --ec-gray-stroke: light-dark(#8a8a8a, #7a8494);
    --ec-width: min(1120px, calc(100vw - 2 * var(--gutter)));

    width: var(--ec-width);
    /* Centre on the entry column (100cqw), not on the narrower prose column. */
    margin: 2.4rem calc((100cqw - var(--ec-width)) / 2);
    font-family: var(--font-mono-stack);
  }

  .experiment-chart__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  /* Doubled class beats `.prose p` margins. */
  .experiment-chart .experiment-chart__sub {
    margin: 0;
    color: var(--text-soft);
    font-size: 13px;
  }

  .experiment-chart__tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-strong);
  }

  .experiment-chart__tabs button {
    appearance: none;
    border: 0;
    border-radius: 6px;
    padding: 8px 12px;
    background: transparent;
    color: var(--text-soft);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }

  .experiment-chart__tabs button.is-active {
    background: var(--ec-green-dark);
    color: #fff;
  }

  .experiment-chart__panel {
    position: relative;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-strong);
    overflow: hidden;
  }

  .experiment-chart__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .experiment-chart__axis-label {
    fill: var(--text-soft);
    font-size: 14px;
    font-weight: 600;
  }

  .experiment-chart__tick {
    fill: var(--text-muted);
    font-size: 12px;
  }

  .experiment-chart__chart-title {
    fill: var(--text);
    font-size: 20px;
    font-weight: 700;
  }

  .experiment-chart__legend {
    fill: var(--text-soft);
    font-size: 13px;
  }

  .experiment-chart__point {
    cursor: crosshair;
    outline: none;
  }

  .experiment-chart__point:focus-visible {
    stroke: var(--text);
    stroke-width: 2.5;
  }

  .experiment-chart__tooltip {
    position: fixed;
    z-index: 10;
    min-width: 210px;
    max-width: 320px;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-strong);
    box-shadow: 0 16px 36px rgb(16 24 40 / 0.18);
    pointer-events: none;
    opacity: 0;
    transition: opacity 80ms ease;
  }

  .experiment-chart__tooltip.is-visible {
    opacity: 1;
  }

  .experiment-chart__tip-name {
    color: var(--text);
    font-weight: 700;
    margin-bottom: 6px;
  }

  .experiment-chart__tip-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .experiment-chart__tip-row strong {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .experiment-chart__header {
      align-items: start;
      flex-direction: column;
    }

    /* Keep labels legible: let the chart scroll sideways instead of shrinking. */
    .experiment-chart__panel {
      overflow-x: auto;
    }

    .experiment-chart__svg {
      width: 680px;
    }
  }
</style>
