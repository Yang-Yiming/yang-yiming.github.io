---
import type { SectionContent } from "../types";
import { renderInlineMarkdown, renderMarkdown } from "../lib/astroMarkdown";

interface Props { section: SectionContent }
const { section } = Astro.props;
---
<section class="editorial-section section-frame" id={section.id}>
  <div class="section-header">
    <div class="section-heading">
      <p class="section-kicker" data-section-anchor={section.id}>{section.kicker}</p>
      <a aria-label={`Link to ${section.navLabel} section`} class="section-heading-link" href={`#${section.id}`}>
        <span aria-hidden="true" class="section-heading-link__anchor">#</span>
        <h2 class="section-title" set:html={renderInlineMarkdown(section.title)} />
      </a>
    </div>
    <div class="section-body">
      {section.sourceLabel && <p class="section-source-label">{section.sourceLabel}</p>}
      <div class="section-intro" set:html={renderMarkdown(section.intro)} />
    </div>
  </div>
  {section.items?.length ? (
    <div class="section-list">
      {section.items.map((item) => (
        item.href ? (
          <a class="list-row list-row--link" href={item.href}>
            <p class="list-row__meta">{item.meta}</p>
            <div class="list-row__body"><h3 class="list-row__title" set:html={renderInlineMarkdown(item.title)} /><div class="list-row__description" set:html={renderMarkdown(item.description)} /></div>
          </a>
        ) : (
          <article class="list-row"><p class="list-row__meta">{item.meta}</p><div class="list-row__body"><h3 class="list-row__title" set:html={renderInlineMarkdown(item.title)} /><div class="list-row__description" set:html={renderMarkdown(item.description)} /></div></article>
        )
      ))}
    </div>
  ) : null}
</section>
