---
import SectionHeader from "./SectionHeader.astro";
import ListRow from "./ListRow.astro";
import { entryHref, entryLabel, isEntryCollection, getEntries, type Section } from "../lib/content";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const entries = isEntryCollection(section.id) ? await getEntries(section.id) : [];
---
<section class="editorial-section section-frame" id={section.id}>
  <SectionHeader section={section} />
  {entries.length > 0 && (
    <div class="section-list">
      {entries.map((entry) => (
        <ListRow
          href={entryHref(entry)}
          label={entryLabel(entry)}
          title={entry.data.title}
          description={entry.data.summary}
          external={Boolean(entry.data.external)}
        />
      ))}
    </div>
  )}
</section>
