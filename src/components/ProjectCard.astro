---
import type { CollectionEntry } from "astro:content";
import { getRepoStats, languageColors } from "../lib/github";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { repo } = project.data;
const stats = await getRepoStats(repo);
const language = stats?.language ?? project.data.language;
const stars = stats && stats.stars > 0 ? new Intl.NumberFormat("en", { notation: "compact" }).format(stats.stars) : undefined;
const updated = stats?.pushedAt.getUTCFullYear();
---
<a class="project-card" href={`https://github.com/${repo}`} target="_blank" rel="noreferrer">
  <div class="project-card__header">
    <h3 class="project-card__title">{repo}</h3>
    <span class="project-card__icon" aria-hidden="true">↗</span>
  </div>
  <div class="project-card__description prose-inline" set:html={project.rendered?.html} />
  <div class="project-card__footer">
    <div class="project-card__meta">
      {language && (
        <span class="project-card__meta-item">
          <span class="project-card__language-dot" style={`--dot: ${languageColors[language] ?? "var(--accent)"}`} />
          {language}
        </span>
      )}
      {stars && <span class="project-card__meta-item">★ {stars}</span>}
    </div>
    {updated && <span class="project-card__meta">Updated {updated}</span>}
  </div>
</a>
