---
interface Props {
  href: string;
  label: string;
  title: string;
  description: string;
  external?: boolean;
}

const { href, label, title, description, external = false } = Astro.props;
---
<a class="list-row" href={href} {...external && { target: "_blank", rel: "noreferrer" }}>
  <p class="list-row__meta">{label}</p>
  <div class="list-row__body">
    <h3 class="list-row__title">{title}{external && <span aria-hidden="true"> ↗</span>}</h3>
    <p class="list-row__description">{description}</p>
  </div>
</a>
